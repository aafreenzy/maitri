# Speech provider key (only if you choose one for audio generation). Never commit a real value.
SARVAM_API_KEY=

# Supabase project URL and the public anon key. Both are safe to put in the app.
# NEVER put the service role key here or anywhere in this repository.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only for npm run check:backend. Two throwaway email-and-password test users. Never real people.
CHECK_USER1_EMAIL=
CHECK_USER1_PASSWORD=
CHECK_USER2_EMAIL=
CHECK_USER2_PASSWORD=
